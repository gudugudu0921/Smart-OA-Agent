# Application
APP_NAME=Smart OA Agent
APP_ENV=production
APP_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080

# MySQL (MYSQL_DATABASE is fixed because init_mysql.sql uses smart_oa)
MYSQL_DATABASE=smart_oa
MYSQL_USER=smart_oa
MYSQL_PASSWORD=replace_with_strong_password
MYSQL_ROOT_PASSWORD=replace_with_root_password

# Redis
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=smart_oa
SESSION_TTL_SECONDS=2592000

# JWT
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM provider
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your_model_name
